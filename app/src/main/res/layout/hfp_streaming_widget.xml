<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hfp_widget_background_off"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">

    <ImageView
        android:id="@+id/hfp_widget_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_bluetooth"
        android:tint="@color/hfp_widget_inactive_content" />

    <TextView
        android:id="@+id/hfp_widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/hfp_widget_streaming_off"
        android:textColor="@color/hfp_widget_inactive_content"
        android:textSize="12sp" />

</LinearLayout>
